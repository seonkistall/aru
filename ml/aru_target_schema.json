{
  "schemaVersion": "2026-07-07.aru-skin-targets.v1",
  "updated": "2026-09-14",
  "purpose": "Define ARU camera targets for cosmetic recommendation, commerce conversion, and clinic handoff without claiming medical diagnosis.",
  "principles": [
    "Camera-visible findings are cosmetic guidance unless a licensed clinician labels the data under a medical workflow.",
    "Product-training labels should come from ARU opt-in crops, trained reviewers, user corrections, or licensed commercial datasets.",
    "Public clinical datasets may support fairness audits, pretraining, or camera QA, but they do not become ARU product ground truth unless their license and task match.",
    "Every target needs capture quality, consent event IDs, device/browser, lighting, makeup state, and reviewer confidence."
  ],
  "currentTargets": [
