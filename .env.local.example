# Copy to .env.local and fill in. All variables are optional unless noted.
# The app runs without them by falling back to localStorage and template output.

# Vision skin analysis (app/api/analyze)
# gemini = test path; openai = production-oriented path
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_VISION_MODEL=gpt-4o-mini

# LLM reason naturalization (app/api/reason)
OPENAI_API_KEY=
# OPENAI_REASON_MODEL=gpt-5.6-luna

# Ops-only Supabase sync (/api/sync). Never expose service_role in client code.
# SUPABASE_SYNC_TOKEN is the operator password typed into /ops before upload.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SYNC_TOKEN=
SUPABASE_CROP_BUCKET=gyeol-crop-samples
SUPABASE_CROP_RETENTION_DAYS=180
SUPABASE_SYNC_ALLOWED_ORIGINS=

# Public funnel ingest (POST /api/funnel). Optional and normally left empty: the route
# defaults to the request's own host, so the deploy needs no configuration. Set it only
# to widen — a comma-separated origin list, e.g. a preview deployment posting to
# production. It does NOT switch anything on; NEXT_PUBLIC_FUNNEL_FLUSH does that, and
# docs/funnel-flush-design.md §5 must be answered by the owner first.
FUNNEL_INGEST_ALLOWED_ORIGINS=

# Re-engagement email (2/4-week routine reminder). Opt-in capture:
# /api/reengage/subscribe (needs Supabase). Scheduled send: /api/reengage/run
# (Vercel Cron in vercel.json). All five values are required; until then the
# loop is a safe no-op. CRON_SECRET and UNSUBSCRIBE_SECRET must be different.
RESEND_API_KEY=
CRON_SECRET=
UNSUBSCRIBE_SECRET=
REENGAGE_FROM=ARU 아루 <hello@your-verified-domain>
REENGAGE_LINK_BASE=https://aru-beauty.vercel.app

# Staff-only production routes: /ops, /pilot, /eval. When either value is
# absent, those routes intentionally return 404 in production.
INTERNAL_TOOLS_USER=
INTERNAL_TOOLS_PASSWORD=

# YouTube Shorts auto-upload (scripts/youtube-upload.mjs)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
