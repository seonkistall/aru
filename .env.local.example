# Copy to .env.local and fill in. All are OPTIONAL — the app runs without them
# (LLM → template fallback, Supabase → localStorage fallback).

# Vision skin analysis (app/api/analyze) — provider swap
#   "gemini" = free tier (test only; free tier may use uploads for training)
#   "openai" = gpt-4o-mini (~0.3원/scan, no training) ← production (B)
VISION_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_VISION_MODEL=gpt-4o-mini

# ① LLM reason naturalization (app/api/reason) — uses OPENAI_API_KEY (gpt-4o-mini)
OPENAI_API_KEY=

# ④ Supabase persistence (lib/supabase.ts) — public anon key is browser-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ② Re-engagement email (app/api/reengage) — e.g. Resend
RESEND_API_KEY=

# ③ YouTube Shorts auto-upload (scripts/youtube-upload.mjs) — Google OAuth
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
