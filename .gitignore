# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
server.out.log
server.err.log

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev/server logs
*.log

# isolated implementation worktrees
/.worktrees/
.gstack/
.toolchains/

# Android local toolchain, signing secrets, and build outputs
/.env.android.local
/android/.gradle/
/android/local.properties
/android/app/build/
/android/build/
/android/*.jks
/android/*.keystore
*.aab
*.apk

# local browser regression artifacts
/test-results/
/playwright-report/

# scan cost benchmark scratch builds (ARU_PRINT_SCAN_COST)
/tests/.scan-cost-tmp/

# blemish constant sensitivity scratch builds
/tests/.blemish-const-tmp/
